{
  "name": "@packpath/digital-link",
  "version": "0.2.0",
  "description": "Parse, build and validate GS1 Digital Link URIs and GS1 element strings. Zero dependencies; runs in browsers, Node.js and Cloudflare Workers.",
  "license": "Apache-2.0",
  "author": "Starlab Systems Limited",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himashi/digital-link.git"
  },
  "homepage": "https://github.com/Himashi/digital-link#readme",
  "bugs": {
    "url": "https://github.com/Himashi/digital-link/issues"
  },
  "keywords": [
    "gs1",
    "digital-link",
    "gtin",
    "barcode",
    "qr-code",
    "application-identifier",
    "element-string",
    "sunrise-2027"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate-ai-table.mjs && node scripts/generate-epc-table.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:smoke": "node test/smoke.cjs && node test/smoke.mjs",
    "docs": "typedoc",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "pnpm run generate && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:smoke && pnpm run check:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
